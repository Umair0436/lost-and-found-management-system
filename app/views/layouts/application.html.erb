<!DOCTYPE html>
<html>
  <head>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <title><%= content_for(:title) || "Practice Project" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Practice Project">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50">

    <% if user_signed_in? %>
      <div class="fixed top-4 right-4 z-50">
        <%= button_to "Sign out", destroy_user_session_path, method: :delete,
          class: "rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
      </div>
    <% end %>

    <% flash.each do |type, message| %>
      <% next if message.blank? %>
      <div class="mx-auto mt-4 max-w-5xl px-4">
        <div class="rounded-lg border px-4 py-3 text-sm <%= type.to_s == "notice" ? "border-green-200 bg-green-50 text-green-800" : "border-red-200 bg-red-50 text-red-800" %>">
          <%= message %>
        </div>
      </div>
    <% end %>

    <main>
      <%= yield %>
    </main>

  </body>
</html>