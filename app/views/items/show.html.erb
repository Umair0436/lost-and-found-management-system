<div class="mx-auto max-w-3xl px-4 py-10">

  <div class="mb-6">
    <%= link_to "← Back to all complaints", items_path,
      class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white p-8">

    <h1 class="mb-6 text-2xl font-bold text-gray-900">
      <%= @item.name %>
    </h1>

    <dl class="space-y-4 text-sm">

      <div>
        <dt class="font-medium text-gray-500">Description</dt>
        <dd class="mt-1 text-gray-900">
          <%= @item.description %>
        </dd>
      </div>

      <div>
        <dt class="font-medium text-gray-500">Location</dt>
        <dd class="mt-1 text-gray-900">
          <%= @item.location %>
        </dd>
      </div>

      <div>
        <dt class="font-medium text-gray-500">Status</dt>
        <dd class="mt-1">
          <span class="inline-block rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700">
            <%= @item.status %>
          </span>
        </dd>
      </div>

    </dl>

    <% if @item.user_id == current_user.id %>

      <div class="mt-6 flex gap-3">

        <%= link_to "Edit",
          edit_item_path(@item),
          class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>

        <%= button_to "Delete",
          item_path(@item),
          method: :delete,
          data: { turbo_confirm: "Are you sure?" },
          class: "rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700" %>

      </div>

    <% end %>

  </div>

  <div class="mt-8 rounded-2xl border border-gray-200 bg-white p-8">
  <h2 class="mb-4 text-lg font-semibold text-gray-900">Comments</h2>

  <% @item.comments.each do |comment| %>
    <div class="mb-4 border-b border-gray-100 pb-4">
      <p class="text-sm text-gray-900"><%= comment.body %></p>
      <p class="mt-1 text-xs text-gray-500"><%= comment.user.email %></p>

      <% if comment.user_id == current_user.id %>
        <div class="mt-2 flex gap-3">
          <%= link_to "Edit", edit_item_comment_path(@item, comment),
            class: "text-xs text-blue-600 hover:underline" %>

          <%= button_to "Delete", item_comment_path(@item, comment),
            method: :delete,
            data: { turbo_confirm: "Are you sure?" },
            class: "text-xs text-red-600 hover:underline bg-transparent border-0 p-0" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= form_with model: [@item, @comment] do |f| %>
    <%= f.text_area :body, rows: 3,
      class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>

    <%= f.submit "Add Comment",
      class: "mt-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
  <% end %>
</div>

</div>